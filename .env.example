# OneProvider MCP server configuration template.
# Copy the real values into ~/Projects/.env (DO NOT commit real values).
# ~/Projects/.env is the default credential file and must not be overwritten.

# Required: OneProvider API credentials (from panel.op-net.com -> API section)
ONEPROVIDER_API_KEY=API_your_api_key_here
ONEPROVIDER_API_SECRET=CK_your_client_key_here

# Optional overrides (defaults shown)
# ONEPROVIDER_BASE_URL=https://api.oneprovider.com
# ONEPROVIDER_ENV_FILE=/home/you/Projects/.env
# ONEPROVIDER_TIMEOUT_SECONDS=30
# ONEPROVIDER_MAX_RETRIES=3

# Safety switches (all OFF by default; read-only mode)
# ONEPROVIDER_ENABLE_WRITES=false        # enables state-changing tools
# ONEPROVIDER_ENABLE_DESTRUCTIVE=false   # additionally enables destructive/financial tools
